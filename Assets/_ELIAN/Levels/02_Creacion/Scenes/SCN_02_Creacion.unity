--- !u!114 &1300748763
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1300748759}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0ea73b7d9f67cd142977545645d0cf4d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  dialogueManager: {fileID: 1045852670}
  lines:
  - speaker: 3
    text: "\xBFEres una pieza nueva? No apareces en ning\xFAn registro."
  - speaker: 1
    text: No soy una pieza.
  - speaker: 3
    text: "Todo lo que hay aqu\xED es una pieza. Esto es el complejo de Creaci\xF3n,
      y todo lo dise\xF1a Faber."
  - speaker: 3
    text: "Yo solo mantengo las m\xE1quinas. Si algo falla, busco el procedimiento
      y lo reemplazo."
  - speaker: 1
    text: "\xBFY si el fallo no aparece en ning\xFAn procedimiento?"
  - speaker: 3
    text: ...Entonces se descarta. Siempre se descarta.
  - speaker: 3
    text: Los Ensambladores ya te detectaron. Para ellos eres una pieza fuera de
      lugar.
  activateOnEnd:
  - {fileID: 1638097053}
