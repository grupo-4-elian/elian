  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0ea73b7d9f67cd142977545645d0cf4d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  dialogueManager: {fileID: 1045852670}
  lines:
  - speaker: 3
    text: "Desarmaste a los Ensambladores. Eso no est\xE1 en el manual."
  - speaker: 1
    text: "\xBFQu\xE9 est\xE1n construyendo?"
  - speaker: 3
    text: "No lo s\xE9. Nadie lo sabe. Siguen las instrucciones y la pieza sale perfecta."
  - speaker: 1
    text: "Antes crear era imaginar algo que no exist\xEDa... y fallar muchas veces
      hasta lograrlo."
  - speaker: 3
    text: "Ahora nada falla. Faber lo dise\xF1a todo antes de que alguien llegue
      a pensarlo."
  - speaker: 1
    text: Entonces no dejaron de producir. Dejaron de crear.
  - speaker: 3
    text: Cuidado. Los Correctores eliminan todo lo que no coincide con el plano.
  activateOnEnd:
  - {fileID: 1481056328}
