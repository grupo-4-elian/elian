  m_Script: {fileID: 11500000, guid: 0ea73b7d9f67cd142977545645d0cf4d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  dialogueManager: {fileID: 1045852670}
  lines:
  - speaker: 0
    text: Parece que los Centinelas no son un problema para ti.
  - speaker: 1
    text: "Antes aprender era buscar el porqu\xE9, comparar... incluso dudar de una
      respuesta."
  - speaker: 0
    text: Ahora basta con recibirla y aceptarla. Cuestionar solo altera el orden.
  - speaker: 1
    text: Entonces el problema no son las respuestas... es dejar de pensar sobre
      ellas.
  - speaker: 0
    text: "Exacto. Y los C\xF3dice se aseguran de que ese orden se mantenga."
  activateOnEnd:
  - {fileID: 1481056328}
