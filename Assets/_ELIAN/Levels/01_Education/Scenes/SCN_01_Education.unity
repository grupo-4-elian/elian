  m_Script: {fileID: 11500000, guid: 0ea73b7d9f67cd142977545645d0cf4d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  dialogueManager: {fileID: 1045852670}
  lines:
  - speaker: 0
    text: "\xBFTe llamas Elian?... \xBFQu\xE9 se supone que eres?"
  - speaker: 0
    text: "No pareces humano. Tampoco pareces una m\xE1quina."
  - speaker: 0
    text: "Est\xE1s en el Limbo de la Educaci\xF3n. Aqu\xED reina Sophia.\n"
  - speaker: 0
    text: Elian, avanza. Debes liberar este sector.
  - speaker: 0
    text: "Equivocarse, investigar, intentar comprender... todo eso qued\xF3 atr\xE1s.\n"
  - speaker: 0
    text: "No s\xE9 qu\xE9 buscas aqu\xED, Elian. Pero los Centinelas se encargar\xE1n
      de ti."
  activateOnEnd:
  - {fileID: 1638097053}
  - {fileID: 1982516502}
